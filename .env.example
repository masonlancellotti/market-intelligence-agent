# MERIDIAN secrets — copy to .env and chmod 600. NEVER commit .env.
# Every connector degrades gracefully when its key is absent (marked `disabled` in health).

# --- LLM (required for the agent layer; without it, briefs run in template-only degrade mode) ---
ANTHROPIC_API_KEY=

# --- Macro / market data ---
FRED_API_KEY=                 # fred.stlouisfed.org/docs/api/api_key.html (instant, free)
ALPACA_KEY_ID=                # alpaca.markets — free, Market Data (IEX)
ALPACA_SECRET_KEY=
FINNHUB_KEY=                  # finnhub.io free tier
COINGECKO_KEY=                # coingecko.com/api demo key (optional; public endpoints work without)

# --- SEC EDGAR requires a real contact UA (name + email) ---
SEC_USER_AGENT=Your Name your-email@example.com

# --- Notifications ---
NTFY_BASE_URL=https://ntfy.sh          # or self-hosted https://ntfy.<tailnet>.ts.net
NTFY_TOPIC_BRIEFS=meridian-briefs
NTFY_TOPIC_ALERTS=meridian-alerts
NTFY_TOKEN=                             # bearer token if the ntfy server requires auth
PUSHOVER_TOKEN=                         # $5 one-time; P0 critical-alert channel
PUSHOVER_USER=
IMESSAGE_TO=                            # optional; phone/email for osascript iMessage (Mac only)

# --- Prediction markets (ported from prediction-terminal; public endpoints, no key needed) ---
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# --- Deployment ---
MERIDIAN_HOME=                          # defaults to repo root if unset
TAILNET_BASE_URL=                       # e.g. https://mini.tailXXXX.ts.net (for deep links + podcast feed)
