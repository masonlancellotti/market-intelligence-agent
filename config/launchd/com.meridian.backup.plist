<?xml version="1.0" encoding="UTF-8"?>
<!-- Nightly backup at 02:30 local (PLAN.md §3): sqlite .backup + Parquet mirror,
     14 dailies / 8 weeklies retention. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.meridian.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__MERIDIAN_HOME__/scripts/backup.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MERIDIAN_HOME</key>
        <string>__MERIDIAN_HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/meridian/backup.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/meridian/backup.log</string>
</dict>
</plist>
